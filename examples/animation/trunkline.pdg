# Dual-path backbone on the trunkline theme: draw-in route, ring flows, background grid.
graph dir=LR theme=trunkline route=ortho radius=0 diagonal=always grid=40 rank-gap=180
dc "Data center" sub="GPU racks" shape=circle
group edge_pop "Edge POP" {
  core "Core switch"
}
group svc "Services" layout=column {
  obj "Object store" .idle
  train "Training cluster"
  infer "Inference" .idle
  peer "Peering" .idle
}
dc -> core "primary" .primary flow=forward flow-speed=.9s
dc -> core "backup" .backup flow=forward flow-speed=1.4s
core -> obj, infer, peer
core -> train .primary flow=draw flow-speed=2.5s
