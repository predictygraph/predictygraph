# Generic theme classes: the diagram says what each item is (.card, .chip, .label,
# .placeholder, .on-blue ...) and the theme picks the colours. Try --theme nord or
# --theme dracula: nothing in this file changes.
graph theme=github-light layout=column gap=14 align=stretch padding=8
group req "Request path" layout=row gap=12 .band {
  client "Client" .card sub="browser or CLI"
  api "API gateway" .on-blue sub="auth, rate limits"
  svc "Service" .frame sub="business logic"
}
group store layout=row gap=12 .open {
  db "Primary DB" .on-green
  cache "Cache" .chip
  spare "spare capacity" .placeholder
  old "retired" .ghost
}
note "reads go to the cache first" .label .quiet
client -> api
api -> svc
svc -> db
svc -> cache
